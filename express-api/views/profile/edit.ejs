<%- include("../partials/header", { title: "Sửa hồ sơ" }) %>
<%- include("../partials/navbar") %>

<main class="page auth-page">
    <form class="auth-card" action="/profile/edit" method="POST">
        <h1>Chỉnh sửa hồ sơ</h1>

        <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" name="fullname" value="<%= profile.fullname %>" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Tuổi</label>
                <input type="number" name="age" value="<%= profile.age %>" min="18" required>
            </div>

            <div class="form-group">
                <label>Thành phố</label>
                <input type="text" name="city" value="<%= profile.city %>">
            </div>
        </div>

        <div class="form-group">
            <label>Giới thiệu bản thân</label>
            <textarea name="bio"><%= profile.bio %></textarea>
        </div>

        <div class="form-group">
            <label>Sở thích (phân tách bằng dấu phẩy)</label>
            <input type="text" name="interests" value="<%= profile.interests.join(', ') %>">
        </div>

        <button class="btn-primary" type="submit">Lưu thay đổi</button>
        <a class="btn-outline" href="/profile">Hủy</a>
    </form>
</main>

<%- include("../partials/footer") %>
