<%- include("../partials/header", { title: "Khám phá" }) %>
<%- include("../partials/navbar") %>

<main class="page discover-page">
    <% if (matched) { %>
        <div class="match-overlay">
            <h1>🎉 Đã match!</h1>
            <p>Bạn và <b><%= matched.name %></b> đã thích nhau.</p>
            <div class="match-overlay-avatars">
                <span class="avatar-lg" style="background:<%= user.color %>"><%= user.initials %></span>
                <span class="avatar-lg" style="background:<%= matched.color %>"><%= matched.initials %></span>
            </div>
            <div class="match-overlay-actions">
                <a class="btn-outline" href="/discover">Tiếp tục khám phá</a>
                <a class="btn-primary" href="/messages/<%= matched.id %>">Gửi lời chào</a>
            </div>
        </div>
    <% } else if (current) { %>
        <p class="discover-count"><%= remaining %> hồ sơ khác đang chờ</p>

        <div class="swipe-card">
            <div class="swipe-card-photo" style="background:<%= current.color %>">
                <%= current.initials %>
            </div>
            <div class="swipe-card-info">
                <h2><%= current.name %>, <%= current.age %></h2>
                <p class="swipe-card-city">📍 <%= current.city %></p>
                <p class="swipe-card-bio"><%= current.bio %></p>
                <div class="tag-list">
                    <% current.interests.forEach(function(tag) { %>
                        <span class="tag"><%= tag %></span>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="swipe-actions">
            <form action="/discover/<%= current.id %>/pass" method="POST">
                <button class="btn-round btn-pass" type="submit" title="Bỏ qua">✕</button>
            </form>
            <form action="/discover/<%= current.id %>/like" method="POST">
                <button class="btn-round btn-like" type="submit" title="Thích">❤</button>
            </form>
        </div>
    <% } else { %>
        <div class="empty-state">
            <h1>Hết hồ sơ rồi!</h1>
            <p>Bạn đã xem hết danh sách khám phá hiện tại. Hãy quay lại sau nhé.</p>
            <a class="btn-primary" href="/matches">Xem danh sách match</a>
        </div>
    <% } %>
</main>

<%- include("../partials/footer") %>
